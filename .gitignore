# Python virtual environment
.venv/

# Audio input files
audio/

# Generated transcription output (contains meeting content — never commit)
transcriptions/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Audio/video files
*.m4a
*.mp3
*.wav
*.mp4

# Secrets — the API key lives in ~/.config/transcribe/gemini.env, never here
.env
.env.*
*.key

# Editor temporary files
*.swp
*.save

# Old environments transcribe.sh moved aside while rebuilding .venv
.venv.broken-*/
